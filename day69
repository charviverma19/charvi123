#include <stdio.h>

int main() {
    int n;
    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n];
    int freq[n+1];   // frequency array (assuming elements are in range 1..n)
    for (int i = 0; i <= n; i++) {
        freq[i] = 0;
    }

    printf("Enter %d elements (1 to %d, with one repeated):\n", n, n-1);
    int repeated = -1;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);

        // Check frequency in same iteration
        if (freq[arr[i]] == 1) {
            repeated = arr[i];
        }
        freq[arr[i]]++;
    }

    printf("Repeated element: %d\n", repeated);

    return 0;
}
